# OPTIONAL — Vikunja task-tracker integration.
#
# You do NOT need this. If you never create a .env (or leave the token as the placeholder
# below), the pipeline runs exactly the same and the sync step simply skips itself with a
# notice. Only fill this in if you use Vikunja and want each opportunity mirrored as a task.
#
# To enable: copy this file to .env and set both values. .env is git-ignored; this template
# is not, so never put a real token here.

# Base API URL of YOUR Vikunja server (note the /api/v1 path). Vikunja's API listens on :3456
# by default. Replace the host with your own (e.g. http://192.168.x.x:3456 or
# https://vikunja.example.com).
VIKUNJA_URL=http://your-vikunja-host:3456/api/v1

# Bot user's API token. In Vikunja: Settings > API Tokens. Starts with "tk_".
# Needs scopes for reading projects and creating/updating tasks.
VIKUNJA_TOKEN=tk_replace_me
